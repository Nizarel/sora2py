# ============================================
# Coca-Cola Video Studio - Environment Configuration
# ============================================

# Application Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Azure OpenAI (Sora-2)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=sora-2

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=videos

# Database (PostgreSQL)
DATABASE_URL=postgresql://admin:changeme@localhost:5432/videostudio
# For Docker Compose, use: postgresql://admin:changeme@db:5432/videostudio

# Database Password (for Docker Compose)
DB_PASSWORD=changeme

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0
# For Docker Compose, use: redis://redis:6379/0

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Video Generation Settings
MAX_VIDEO_DURATION=120
DEFAULT_VIDEO_RESOLUTION=1280x720
MAX_RESOLUTION=1920x1080

# Frontend API URL (for production, set to your backend URL)
VITE_API_URL=/api/v1
